# ==================================================
# Secrets & environment — never commit real credentials
# ==================================================
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
.netrc
credentials.json
*.credentials
secrets/
*.secret
*_secret*
service-account*.json
*.token
token.json
auth.json

# Cookies & session/auth state (Playwright storage state, browser sessions,
# HTTP archives that can embed session cookies/tokens)
*cookies*.json
cookie_jar*
storage_state.json
storage-state.json
*.session
sessions/
*.har

# Playwright browser profiles / user-data dirs (Phase 16 automation)
.playwright-mcp/
playwright/.auth/
user-data-dir/
browser_profile/

# ==================================================
# Personal data — resume, applications, database, settings
# ==================================================
data/
applications/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==================================================
# Python
# ==================================================
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# ==================================================
# Node / n8n
# ==================================================
node_modules/
.n8n/

# ==================================================
# Playwright test artifacts
# ==================================================
playwright-report/
test-results/

# ==================================================
# OS
# ==================================================
.DS_Store

# ==================================================
# Logs
# ==================================================
*.log
logs/

