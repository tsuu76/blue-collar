# ==================================================
# IT Job Hunter — Environment Configuration
# Copy this file to .env and adjust values.
# Everything in this file must remain $0/month. Do not
# point AI_PROVIDER, PDF, or notification settings at any
# paid/cloud service — see COST PROTECTION in README.md.
# ==================================================

APP_NAME=IT-Job-Hunter
APP_ENV=local

# --- Local AI (Ollama only — never a paid API) ---
# OLLAMA_MODEL default chosen by benchmarking locally-pulled models on this
# machine (see: python -m src.ai.benchmark). llama3:latest gave reliable
# strict-JSON output at ~9.6s/call; qwen3:8b's "thinking" mode made it too
# slow (87-120s/call, sometimes timing out) for a pipeline processing many
# jobs. Re-run the benchmark if you pull different models later.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_QC_MODEL=mistral:latest
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3

# --- Targeting ---
TARGET_DOMAIN=IT
TARGET_LEVEL=ENTRY
TARGET_LOCATIONS=Sydney,Greater Sydney,NSW,Remote Australia,Hybrid Sydney

# --- Experience filter ---
MAX_EXPERIENCE_YEARS=2
EXPERIENCE_SOFT_CAP_YEARS=2

# --- Scoring ---
MIN_FIT_SCORE=75
WEIGHT_ENTRY_LEVEL=0.30
WEIGHT_IT_RELEVANCE=0.25
WEIGHT_SKILLS_MATCH=0.20
WEIGHT_EXPERIENCE_MATCH=0.15
WEIGHT_LOCATION=0.10

# --- Automation safety (dangerous/irreversible defaults OFF) ---
AUTO_GENERATE_APPLICATIONS=true
AUTO_SUBMIT_APPLICATIONS=false
ALLOW_BROWSER_AUTOMATION=false

# --- Cover letter ---
COVER_LETTER_MIN_WORDS=250
COVER_LETTER_MAX_WORDS=400

# --- Direct company outreach ---
# A "Run outreach" run goes all the way through on its own: research, contact
# discovery, drafting, the quality gate, and then SMTP. There is no approval
# step, so these two settings are what stand between a bug and a real inbox.
#
# OUTREACH_DRY_RUN stays true until you've read some generated emails and are
# happy with them. With it on, drafts are written and gated exactly as normal
# but no SMTP connection is ever opened — it is an absolute veto that no flag,
# button or argument can override.
OUTREACH_DRY_RUN=true
# The most emails outreach may send in one day, counted across every run.
# Raise it when you trust what it's writing.
OUTREACH_DAILY_LIMIT=5
# Outreach emails are short by design (~120-180 words). A cold email that
# reads like a cover letter gets deleted.
OUTREACH_EMAIL_MIN_WORDS=110
OUTREACH_EMAIL_MAX_WORDS=190

# --- SMTP (your own mailbox — never a paid transactional email service) ---
# Use an app-password from your mail provider, NOT your account password.
# Gmail: myaccount.google.com/apppasswords (requires 2FA enabled).
# Real values belong in .env only — .env is gitignored, this file is not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- Database ---
DATABASE_PATH=./data/jobs.db

# --- PDF rendering ---
PDF_ENGINE=playwright

# --- Dashboard (local only) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8420

# --- n8n (local only, never exposed publicly) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# --- Notifications (all optional, all free) ---
NOTIFY_DESKTOP=true
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
