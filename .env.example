# ==================================================
# IT Job Hunter — Environment Configuration
# Copy this file to .env and adjust values.
# Everything in this file must remain $0/month. Do not
# point AI_PROVIDER, PDF, or notification settings at any
# paid/cloud service — see COST PROTECTION in README.md.
# ==================================================

APP_NAME=IT-Job-Hunter
APP_ENV=local

# --- Local AI (Ollama only — never a paid API) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_QC_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# --- Targeting ---
TARGET_DOMAIN=IT
TARGET_LEVEL=ENTRY
TARGET_LOCATIONS=Sydney,Greater Sydney,NSW,Remote Australia,Hybrid Sydney

# --- Experience filter ---
MAX_EXPERIENCE_YEARS=2
EXPERIENCE_SOFT_CAP_YEARS=2

# --- Scoring ---
MIN_FIT_SCORE=75
WEIGHT_ENTRY_LEVEL=0.30
WEIGHT_IT_RELEVANCE=0.25
WEIGHT_SKILLS_MATCH=0.20
WEIGHT_EXPERIENCE_MATCH=0.15
WEIGHT_LOCATION=0.10

# --- Automation safety (dangerous/irreversible defaults OFF) ---
AUTO_GENERATE_APPLICATIONS=true
AUTO_SUBMIT_APPLICATIONS=false
ALLOW_BROWSER_AUTOMATION=false

# --- Cover letter ---
COVER_LETTER_MIN_WORDS=250
COVER_LETTER_MAX_WORDS=400

# --- Database ---
DATABASE_PATH=./data/jobs.db

# --- PDF rendering ---
PDF_ENGINE=playwright

# --- n8n (local only, never exposed publicly) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# --- Notifications (all optional, all free) ---
NOTIFY_DESKTOP=true
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
